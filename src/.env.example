PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/dadyar

JWT_ACC_SECRET=replace-with-a-long-random-secret

JWT_REF_SECRET=replace-with-a-long-random-secret

JWT_ISSUER=dadyar-api

JWT_AUDIENCE=dadyar-web

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

NODE_ENV=development

ORIGIN=http://localhost:3000
CREDENTIAL=true

TRUST_PROXY=false
COOKIE_SECURE=false

LANGUAGE=fa
ENABLE_API_DOCS=true

SMSIR_API_KEY=your-real-api-key

SMSIR_OTP_TEMPLATE_ID=123456

OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_HMAC_SECRET=replace-with-a-long-random-secret
OTP_RESEND_COOLDOWN_SECONDS=60

REDIS_URL=redis://127.0.0.1:6379

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

STORAGE_ROOT=./storage

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
